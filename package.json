{
  "name": "cortico-world-qq2",
  "version": "0.1.3",
  "type": "module",
  "description": "Coopanion / Cortico 的 QQ World，连接 NapCat OneBot 11，支持群聊四档、历史查找、图片与发送回执。",
  "author": "筆離嘢",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biliye/cortico-world-qq2.git"
  },
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "dist/webui.js",
    "dist/webui.css",
    "describe.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "build:webui": "esbuild src/webui/client.ts --bundle --format=esm --outfile=dist/webui.js --tsconfig=tsconfig.web.json",
    "prepack": "pnpm build:webui"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "describe": "describe.json",
    "tags": ["external-setup"]
  },
  "dependencies": {
    "omggif": "1.0.10",
    "pngjs": "7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/omggif": "^1.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
